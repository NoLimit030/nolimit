end
local function captureSky()
    if saved then return end
    saved=true
    for _,object in ipairs(Lighting:GetChildren()) do
        if object:IsA("Sky") or object:IsA("Atmosphere") then
            originals[#originals+1]={object=object,parent=Lighting}
