local launcherDrag,launcherStart,launcherPosition,launcherMoved
connect(launcher.InputBegan,function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
        launcherDrag=input
        launcherStart=input.Position
        launcherPosition=launcher.Position
        launcherMoved=false
    end
end)
connect(UIS.InputChanged,function(input)
    if not launcherDrag then return end
    if input.UserInputType~=Enum.UserInputType.MouseMovement and input~=launcherDrag then return end
    local delta=input.Position-launcherStart
    if delta.Magnitude>5 then launcherMoved=true end
    if launcherMoved then
        local camera=workspace.CurrentCamera
        local viewport=camera and camera.ViewportSize or Vector2.new(800,600)
        local x=launcherPosition.X.Offset+delta.X
        local y=launcherPosition.Y.Offset+delta.Y
        launcher.Position=UDim2.fromOffset(math.clamp(x,8,math.max(8,viewport.X-64)),
            math.clamp(y,8,math.max(8,viewport.Y-100)))
    end
end)
connect(UIS.InputEnded,function(input)
    if input==launcherDrag then launcherDrag=nil end
end)
connect(launcher.Activated,function()
    if not launcherMoved then
        launcherScale.Scale=1
        setMenuVisible(true)
    end
