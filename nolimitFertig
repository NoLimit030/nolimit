end
local function updateESP()
    local localCharacter=me.Character
    local localRoot=localCharacter and (localCharacter:FindFirstChild("HumanoidRootPart") or localCharacter.PrimaryPart)
    local camera=workspace.CurrentCamera
    local origin=localRoot and localRoot.Position or (camera and camera.CFrame.Position)
    for player, record in pairs(markers) do
        if player.Parent~=Players or player.Character~=record.character or not record.character.Parent then
            record.highlight:Destroy()
            record.tag:Destroy()
            markers[player]=nil
        end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        local character=player.Character
        if player~=me and character and character.Parent then
            local part=character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
            if part then
                local record=markers[player]
                if not record then
                    local highlight=make("Highlight",{Adornee=character,DepthMode=Enum.HighlightDepthMode.AlwaysOnTop,
                        FillTransparency=0.25,OutlineTransparency=0,ThemeIgnore=true},gui)
                    local tag=make("BillboardGui",{Adornee=part,Size=UDim2.fromOffset(220,36),
                        StudsOffset=Vector3.new(0,2,0),AlwaysOnTop=true,ThemeIgnore=true},gui)
                    local name=text(tag,player.DisplayName,0,0,220,30,13,C.text,true)
                    name.TextXAlignment=Enum.TextXAlignment.Center
                    name.TextStrokeTransparency=0.35
                    record={character=character,highlight=highlight,tag=tag,label=name}
                    markers[player]=record
                end
                local color=palette[espOptions.color] or C.accent
                record.highlight.FillColor=color
                record.highlight.OutlineColor=color
                record.highlight.Enabled=espOptions.outlines
                record.label.TextColor3=color
                record.tag.Adornee=part
                local pieces={}
                if espOptions.names then table.insert(pieces,player.DisplayName) end
                if espOptions.distance and origin then
                    table.insert(pieces,tostring(math.floor((part.Position-origin).Magnitude+0.5)).." studs")
                end
                record.label.Text=table.concat(pieces,"  ·  ")
                record.tag.Enabled=#pieces>0
            end
        end
    end
end

local function buildCombat()
local modules = me.PlayerScripts.Client.Controllers
local Config = require(RS.Shared.Config)
local Movement = require(modules.MovementController)
local Camera = require(modules.CameraController)
local Animation = require(modules.AnimationController)
local Charge = require(modules.AttackCharge)
local Sync = require(modules.RemoteSync)
local World = require(modules.WorldRenderer)
local Inventory = require(modules.InventoryController)
local Attack = RS.Remotes.Attack
local attackInterval = 1 / math.max(1, Config.Combat.MaxAttacksPerSecond)
local lastAttackAt = -math.huge
local function step()
    if os.clock() - lastAttackAt < attackInterval then return end
    local character = Movement.getCharacter()
    local state = Movement.getState()
    if not character or not state then return end
    if character:GetAttribute("Zone") ~= "Arena" then return end
    if (character:GetAttribute("Health") or 0) <= 0 then return end
    if Inventory.getUsing() ~= nil then return end
    local charge = Charge.scale(Config.Combat.Cooldown.AttackAdjust)
    if charge < 1 then return end
    local eye = Camera.getRenderEye()
    local world = World.getWorld()
    if not eye or not world then return end
    local target, direction
    local closest = Config.Combat.Reach.Entity
    for _, player in ipairs(Players:GetPlayers()) do
        local model = player.Character
        if player ~= me and model
            and model:GetAttribute("Zone") == "Arena"
            and (model:GetAttribute("Health") or 0) > 0
            and model:GetAttribute("CombatantId") ~= nil then
            local feet = Animation.getRenderFeet(model)
            if feet then
                local center = feet + Vector3.new(0, Config.Physics.PlayerHeight / 2, 0)
                local delta = center - eye
                local distance = delta.Magnitude
                if distance > 0 and distance < closest then
                    local hit = world:raycast(eye, delta.Unit, distance, {solidOnly = true})
                    if not hit then
                        target, direction, closest = model, delta.Unit, distance
                    end
                end
            end
        end
    end
    if not target then return end
    local camera = workspace.CurrentCamera
    local root = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
    if camera and root then
        local position = camera.CFrame.Position
        if (root.Position - position).Magnitude > 0.01 then
            camera.CFrame = CFrame.lookAt(position, root.Position)
        end
    end
    local sentAt = os.clock()
    lastAttackAt = sentAt
    Attack:FireServer(target, {
        sprint = Movement.isServerSprinting(),
        crit = state.fallDistance > 0 and not state.onGround
            and not state.inWater and not state.onLadder,
        eye = eye,
        dir = direction,
        charge = charge,
        t = sentAt,
        vt = Sync.viewTime(target:GetAttribute("CombatantId")),
    })
    Charge.reset()
end


return step
end
