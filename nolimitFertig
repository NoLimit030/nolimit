local function toggleRow(y,title,description,callback,parent,width)
    local w=width or 397
    local row = make("Frame",{Position=UDim2.fromOffset(0,parent and y or y-149),Size=UDim2.fromOffset(w,65),
        BackgroundColor3=C.card,BorderSizePixel=0},parent or overviewControls)
    round(row,10)
    make("UIStroke",{Color=C.line,Thickness=1,Transparency=0.45},row)
    text(row,title,15,11,w-147,22,14,C.text,true)
    text(row,description,15,35,w-100,17,11,C.muted)
    local label = text(row,"OFF",w-103,22,35,20,10,C.muted,true)
    local switch = make("TextButton",{Position=UDim2.fromOffset(w-63,21),Size=UDim2.fromOffset(48,24),
        BackgroundColor3=C.off,Text="",BorderSizePixel=0,AutoButtonColor=false},row)
    round(switch,12)
    local knob = make("Frame",{Position=UDim2.fromOffset(3,3),Size=UDim2.fromOffset(18,18),
        BackgroundColor3=C.text,BorderSizePixel=0},switch)
    round(knob,9)
    local value = false
    local colorTween
    table.insert(themeRefreshers,function()
        if colorTween then colorTween:Cancel() end
        switch.BackgroundColor3=value and C.accent or C.off
        knob.BackgroundColor3=value and (C.onAccent or C.text) or C.text
        label.TextColor3=value and C.text or C.muted
    end)
    local function set(on)
        value = on
        label.Text = on and "ON" or "OFF"
        label.TextColor3 = on and C.text or C.muted
        if colorTween then colorTween:Cancel() end
        colorTween=TweenService:Create(switch,TweenInfo.new(0.15),{BackgroundColor3=on and C.accent or C.off})
        colorTween:Play()
        knob.BackgroundColor3=on and (C.onAccent or C.text) or C.text
        TweenService:Create(knob,TweenInfo.new(0.15),{Position=UDim2.fromOffset(on and 27 or 3,3)}):Play()
        callback(on)
    end
    connect(switch.Activated,function() set(not value) end)
    return set
end
