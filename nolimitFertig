local function applyTheme(value)
    local chosen=themes[value] and value or nil
    if not chosen then
        local legacy=validHex(value)
        if not legacy then return false end
        local color=fromHex(legacy)
        local distance=math.huge
        for _,id in ipairs(themeOrder) do
            local candidate=themes[id].colors.accent
            local d=(candidate.R-color.R)^2+(candidate.G-color.G)^2+(candidate.B-color.B)^2
            if d<distance then chosen,distance=id,d end
        end
    end
    themeId=chosen
    themeHex=themes[chosen].hex
    for name,color in pairs(themes[chosen].colors) do C[name]=color end
    for _,object in ipairs(gui:GetDescendants()) do
        local ignored=false
        local ancestor=object
        while ancestor and ancestor~=gui do
            if themeIgnored[ancestor] then ignored=true break end
            ancestor=ancestor.Parent
        end
        if not ignored then
            for property,name in pairs(themeBindings[object] or {}) do object[property]=C[name] end
            if object:IsA("UIGradient") then
                object.Color=ColorSequence.new(C.panel:Lerp(C.accent,0.18),C.background)
            end
            if object:IsA("ScrollingFrame") then object.ScrollBarImageColor3=C.line end
        end
    end
    for _,refresh in ipairs(themeRefreshers) do refresh() end
    if syncThemeControls then syncThemeControls() end
    return true
end
