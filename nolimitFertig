local function setMenuVisible(show)
    if not running then return end
    menuVisible=show
    if launcher then launcher.Visible=not show end
    animationVersion=animationVersion+1
    local version=animationVersion
    for _, tween in ipairs(menuTweens) do tween:Cancel() end
    frame.Visible=true
    local info=TweenInfo.new(0.18,Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
    menuTweens={
        TweenService:Create(frame,info,{GroupTransparency=show and 0 or 1}),
        TweenService:Create(motionScale,info,{Scale=show and 1 or 0.96})
    }
    for _, tween in ipairs(menuTweens) do tween:Play() end
    if not show then
        task.delay(0.19,function()
            if running and animationVersion==version and not menuVisible then
                frame.Visible=false
            end
        end)
    end
end
