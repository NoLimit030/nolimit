local function validHex(value)
    if type(value)~="string" then return nil end
    local clean=value:gsub("%s",""):gsub("^#",""):upper()
    if #clean~=6 or clean:find("[^%x]") then return nil end
    return clean
end
local function make(class, props, parent)
    local object = Instance.new(class)
    for k, v in pairs(props) do
        if k~="ThemeIgnore" then
            object[k] = v
            if typeof(v)=="Color3" and (k=="BackgroundColor3" or k=="TextColor3" or k=="Color") then
                for name,color in pairs(C) do
                    if name~="onAccent" and color==v then
                        themeBindings[object]=themeBindings[object] or {}
                        themeBindings[object][k]=name
                        break
                    end
                end
            end
        end
    end
    if props.ThemeIgnore then themeIgnored[object]=true end
    object.Parent = parent
    return object
end
