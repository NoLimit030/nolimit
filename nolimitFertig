local alphabet="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local decodeMap={}
for i=1,#alphabet do decodeMap[alphabet:sub(i,i)]=i-1 end
local function decodeBase64(encoded)
    local output={}
    for i=1,#encoded,4 do
        local a,b,c,d=encoded:sub(i,i),encoded:sub(i+1,i+1),encoded:sub(i+2,i+2),encoded:sub(i+3,i+3)
        local packed=(decodeMap[a] or 0)*262144+(decodeMap[b] or 0)*4096
            +(decodeMap[c] or 0)*64+(decodeMap[d] or 0)
        local x,y,z=math.floor(packed/65536)%256,math.floor(packed/256)%256,packed%256
        output[#output+1]=d~="=" and string.char(x,y,z) or (c~="=" and string.char(x,y) or string.char(x))
    end
    return table.concat(output)
end
local function textures(id)
