            candidate=Instance.new("Sky")
            candidate.Name="NoLimitSky"
            candidate.CelestialBodiesShown=false
            candidate.StarCount=0
            for face,asset in pairs(assets) do candidate["Skybox"..face]=asset end
            local failed=false
            ContentProvider:PreloadAsync({candidate},function(_,result)
                if result~=Enum.AssetFetchStatus.Success then failed=true end
            end)
            assert(not failed,"The executor could not display a local sky texture")
            if not running or request~=version or not sky.enabled then return end
            captureSky()
            if ownSky then ownSky:Destroy() end
            ownSky=candidate
            candidate=nil
