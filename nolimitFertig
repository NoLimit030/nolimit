local function buildKnockbackControl()
    local Movement=require(me.PlayerScripts.Client.Controllers.MovementController)
    local installed={}
    local function restore()
        for name,entry in pairs(installed) do
            if Movement[name]==entry.wrapper then Movement[name]=entry.original end
            installed[name]=nil
        end
    end
    return function(on)
        if not on then restore() return end
        if next(installed) then return end
        for _,name in ipairs({"setMotion","addMotion"}) do
            assert(type(Movement[name])=="function",name.." is unavailable")
        end
        local ok,err=pcall(function()
            for _,name in ipairs({"setMotion","addMotion"}) do
                local previous=Movement[name]
                local wrapper=function(...)
                    if running and knockbackEnabled then return end
                    return previous(...)
                end
                installed[name]={original=previous,wrapper=wrapper}
                Movement[name]=wrapper
            end
        end)
        if not ok then
            restore()
            error(err)
        end
    end
end
