local profilePath="NoLimit-profile-"..tostring(me.UserId)..".json"
local function snapshot()
    return {version=1,autoCombat=enabled,esp=espEnabled,speed=speedEnabled,
        speedMultiplier=speedMultiplier,menuKey=menuKey.Name,showStats=showStats,
        espOptions={names=espOptions.names,distance=espOptions.distance,outlines=espOptions.outlines,
            teamColors=espOptions.teamColors,color=espOptions.color}}
end
local setStats
local function applyProfile(data)
    assert(type(data)=="table" and data.version==1,"Unsupported profile")
    local options=type(data.espOptions)=="table" and data.espOptions or {}
    local function boolean(value,default)
        if type(value)=="boolean" then return value end
        return default
    end
    local multiplier=data.speedMultiplier
    if type(multiplier)~="number" or multiplier~=multiplier or math.abs(multiplier)==math.huge then multiplier=1.5 end
    setSpeedMultiplier(multiplier)
    setNames(boolean(options.names,true))
    setDistance(boolean(options.distance,true))
    setOutlines(boolean(options.outlines,true))
    setTeamColors(boolean(options.teamColors,false))
    setESPColor(palette[options.color] and options.color or "Blue")
    local key=Enum.KeyCode.RightShift
    if type(data.menuKey)=="string" then
        local ok, saved=pcall(function() return Enum.KeyCode[data.menuKey] end)
        if ok and saved and saved~=Enum.KeyCode.Unknown and saved~=Enum.KeyCode.Escape
            and not saved.Name:match("^Button") and not saved.Name:match("^Thumbstick") then key=saved end
    end
    menuKey=key
    choosingKey=false
    keyButton.Text=menuKey.Name:gsub("(%l)(%u)","%1 %2")
    keyButton.BackgroundColor3=C.card
    keyHint.Text="Click to change"
    setStats(boolean(data.showStats,true))
    setCombat(boolean(data.autoCombat,false))
    setESP(boolean(data.esp,false))
    setSpeed(boolean(data.speed,false))
end
local function saveProfile()
    if type(writefile)~="function" then
        profileNote.Text="Saving unavailable: executor has no writefile."
        status.Text="Profile could not be saved"
        return
    end
    local ok, err=pcall(function() writefile(profilePath,HttpService:JSONEncode(snapshot())) end)
    profileNote.Text=ok and "Saved locally. Auto-load is ready." or "Save failed — check F9."
    status.Text=ok and "Profile saved" or "Profile save failed"
    if not ok then warn("NoLimit save: "..tostring(err)) end
end
local function loadProfile(automatic)
    if type(readfile)~="function" then
        if not automatic then profileNote.Text="Loading unavailable: executor has no readfile." end
        return
    end
    local readable, contents=pcall(readfile,profilePath)
    if not readable then
        if not automatic then profileNote.Text="No saved profile found. Save one first." end
        return
    end
    local ok,err=pcall(function() applyProfile(HttpService:JSONDecode(contents)) end)
    profileNote.Text=ok and "Default profile loaded." or "Invalid profile — save a new one."
    status.Text=ok and "Profile loaded" or "Profile load failed"
    if not ok then warn("NoLimit load: "..tostring(err)) end
end
